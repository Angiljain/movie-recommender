pd_screening_system/
│
├── 📁 data/
│   ├── 📁 raw/
│   │   ├── 📁 mri/                    # Raw MRI files (.nii, .nii.gz)
│   │   ├── 📁 handwriting/            # Handwriting images (.jpg, .png)
│   │   ├── 📁 clinical/               # Clinical CSV files
│   │   └── 📁 knowledge_base/         # PDFs, research papers
│   │       ├── updrs_guidelines.pdf
│   │       ├── gait_analysis.pdf
│   │       ├── neuroqol_docs.pdf
│   │       └── parkinsons_research.pdf
│   │
│   ├── 📁 processed/
│   │   ├── processed_mris.pkl
│   │   ├── processed_handwriting.pkl
│   │   ├── clinical_assessments.csv
│   │   └── data_splits.json
│   │
│   └── 📁 embeddings/
│       ├── knowledge_base.db          # Chroma/FAISS vector database
│       └── embeddings_metadata.json
│
├── 📁 models/
│   ├── mri_model.pkl                  # Trained MRI classifier
│   ├── handwriting_model.pkl          # Handwriting analysis model
│   ├── clinical_model.pkl             # Clinical data model
│   ├── fusion_model.pkl               # Multimodal fusion model
│   └── model_metadata.json
│
├── 📁 src/
│   ├── __init__.py
│   ├── ppmi_processing.py             # Data preprocessing
│   ├── train_models.py                # Model training pipeline
│   ├── pd_screening_system.py         # Inference engine
│   ├── rag_engine.py                  # RAG + LLM integration
│   └── utils.py                       # Helper functions
│
├── 📁 app/
│   ├── pd_screening_app.py            # Main Streamlit application
│   ├── components/
│   │   ├── __init__.py
│   │   ├── upload_handler.py          # File upload utilities
│   │   ├── visualization.py           # Charts and plots
│   │   └── report_generator.py        # PDF/Doc report creation
│   └── assets/
│       ├── logo.png
│       ├── styles.css
│       └── templates/
│           ├── patient_report.html
│           └── doctor_report.html
│
├── 📁 notebooks/
│   ├── data_exploration.ipynb
│   ├── model_development.ipynb
│   └── rag_testing.ipynb
│
├── 📁 tests/
│   ├── __init__.py
│   ├── test_preprocessing.py
│   ├── test_models.py
│   └── test_rag.py
│
├── 📁 configs/
│   ├── model_config.yaml
│   ├── rag_config.yaml
│   └── app_config.yaml
│
├── 📁 outputs/
│   ├── 📁 reports/                    # Generated patient reports
│   ├── 📁 logs/                       # Application logs
│   └── 📁 predictions/                # Saved predictions
│
├── requirements.txt
├── setup.py
├── README.md
├── .gitignore
└── run_app.sh                         # Quick start script